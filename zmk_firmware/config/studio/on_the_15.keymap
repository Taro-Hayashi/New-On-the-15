/* Generic Studio-enabled stock keymap for a standalone x7/x8 half. */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        bt_fb: bluetooth_feedback {
            compatible = "onthe15,behavior-bt-feedback";
            #binding-cells = <2>;
            display-name = "Bluetooth Feedback";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&lt 1 ESC  &kp N1     &kp N2 &kp N3 &kp N4 &kp N5 &kp MINUS &kp EQUAL
&kp TAB    &kp Q      &kp W  &kp E  &kp R  &kp T  &kp LGUI  &kp LALT
&kp LCTRL  &kp A      &kp S  &kp D  &kp F  &kp G  &kp LANG2 &kp LANG1
&kp LSHFT  &kp Z      &kp X  &kp C  &kp V  &kp B  &lt 2 SPACE &lt 2 SPACE
&kp RIGHT &kp LEFT
            >;
        };

        maintenance_layer: maintenance_layer {
            display-name = "Maintenance";
            bindings = <
&trans &bt_fb BT_SEL 0 &bt_fb BT_SEL 1 &bt_fb BT_SEL 2 &bt_fb BT_SEL 3 &bt_fb BT_SEL 4 &trans &trans
&trans &trans       &trans       &trans       &trans       &trans       &trans &trans
&trans &trans       &trans       &trans       &trans       &trans       &out OUT_TOG &out OUT_TOG
&trans &trans       &trans       &trans       &trans       &trans       &studio_unlock &studio_unlock
&bootloader &trans
            >;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F11 &kp F12
&trans &trans &trans &trans &trans &trans &trans  &trans
&trans &trans &trans &trans &trans &trans &trans  &trans
&trans &trans &trans &trans &trans &trans &trans  &trans
&trans &trans
            >;
        };
    };
};
