/* Personal Studio-enabled stock keymap for the one-piece x15. */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        bt_fb: bluetooth_feedback {
            compatible = "onthe15,behavior-bt-feedback";
            #binding-cells = <2>;
            display-name = "Bluetooth Feedback";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&lt 1 ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp GRAVE &kp BSPC
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp LCTRL &kp LALT &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT
&kp LGUI  &kp A  &kp S  &kp D  &kp F  &kp G  &kp SPACE &kp SPACE &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp ENTER
&kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &lt 2 LANG2 &lt 2 LANG1 &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp BSLH &mt LSHFT F7
&bt_fb BT_SEL 1 &bt_fb BT_SEL 0
            >;
        };

        maintenance_layer: maintenance_layer {
            display-name = "Maintenance";
            bindings = <
&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &out OUT_TOG
&ind_tog &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &studio_unlock
&bootloader &bt BT_CLR
            >;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans &kp DEL
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp UP &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp LEFT &kp DOWN &kp RIGHT
&trans &trans
            >;
        };
    };
};
