+/* DIAG: dump the shared keyspace pool budget and every live slot's extent, so a
+ * spurious "pool full" can be told apart from a genuinely exhausted budget. */
+static void runtime_macro_diag_pool(const char *where, int ret) {
+    size_t used = zmk_custom_setting_large_pool_used(runtime_macros.large_pool);
+    LOG_ERR("DIAG %s ret=%d pool_used=%u pool_size=%u", where, ret, (uint32_t)used,
+            (uint32_t)runtime_macros.large_pool->size);
+    for (uint32_t i = 0; i < runtime_macros.max_entries; i++) {
+        if (!runtime_macros.slots[i].in_use) {
+            LOG_ERR("DIAG   slot %u free", i);
+            continue;
+        }
+        const struct zmk_custom_setting *slot = &runtime_macros.slots[i].setting;
+        LOG_ERR("DIAG   slot %u key=%s blob=%u", i,
+                zmk_custom_setting_public_key(slot) ? zmk_custom_setting_public_key(slot) : "?",
+                (uint32_t)slot->state->blob.size);
+    }
+}
