@@ -3423,6 +3431,56 @@ static int custom_settings_list_array_test_init(void) {
 
 SYS_INIT(custom_settings_list_array_test_init, APPLICATION, 99);
 
+/* DYA Studio encodes an array element as an indexed SettingRef plus a scalar
+ * value. Verify that this wire form grows the active array, matching the
+ * explicit SettingArrayValue form. */
+static int custom_settings_indexed_ref_array_growth_test_init(void) {
+    const struct zmk_custom_setting *array =
+        zmk_custom_setting_find_array("test", "array_value");
+    if (!array) {
+        return -ENOENT;
+    }
+
+    int ret = zmk_custom_setting_reset(array);
+    if (ret < 0) {
+        return ret;
+    }
+    uint32_t old_size = zmk_custom_setting_array_size(array);
+    if (old_size >= zmk_custom_setting_array_max_size(array)) {
+        return -ERANGE;
+    }
+
+    struct zmk_custom_settings_setting_ref ref = {
+        .has_custom_subsystem_id = true,
+        .has_key = true,
+        .has_source = true,
+        .source = ZMK_CUSTOM_SETTING_SOURCE_LOCAL,
+        .has_array_index = true,
+        .array_index = old_size,
+    };
+    copy_string(ref.custom_subsystem_id, sizeof(ref.custom_subsystem_id), "test");
+    copy_string(ref.key, sizeof(ref.key), "array_value");
+
+    struct zmk_custom_setting_value value = ZMK_CUSTOM_SETTING_VALUE_INT32(77);
+    cormoran_zmk_custom_settings_Response resp = cormoran_zmk_custom_settings_Response_init_zero;
+    ret = handle_private_write_setting(
+        &ref, &value, false, 0, 0,
+        cormoran_zmk_custom_settings_SettingWriteMode_SETTING_WRITE_MODE_MEMORY, &resp, false);
+    if (ret < 0 || zmk_custom_setting_array_size(array) != old_size + 1) {
+        LOG_ERR("Indexed-ref array write did not grow size from %u", old_size);
+        return ret < 0 ? ret : -EINVAL;
+    }
+
+    ret = zmk_custom_setting_reset(array);
+    if (ret < 0) {
+        return ret;
+    }
+    LOG_INF("PASS: custom_settings_indexed_ref_array_growth %u->%u", old_size, old_size + 1);
+    return 0;
+}
+
+SYS_INIT(custom_settings_indexed_ref_array_growth_test_init, APPLICATION, 99);
+
 /* ListSettings/GetSetting must surface keyspace entries by their USER key
