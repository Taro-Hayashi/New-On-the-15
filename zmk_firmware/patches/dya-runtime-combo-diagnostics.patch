 #include <zephyr/sys/byteorder.h>
 #include <zephyr/sys/util.h>
 
@@ -692,6 +693,12 @@
      * attempting the flash save), so the cache must refresh regardless of
      * any call's outcome. */
     runtime_combo_cache_rebuild_slot(index);
+    LOG_ERR("DIAG write idx=%u persist=%d req_size=%u combo_ret=%d behavior_ret=%d name_ret=%d "
+            "sizes combos=%u behaviors=%u names=%u",
+            index, (int)persist, array_size, write_ret, behavior_ret, name_ret,
+            zmk_custom_setting_array_size(combo_setting(index)),
+            zmk_custom_setting_array_size(behavior_setting(index)),
