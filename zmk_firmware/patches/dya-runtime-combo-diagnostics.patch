     if (write_ret < 0) {
         return write_ret;
     }
@@ -1415,9 +1422,42 @@
 ZMK_LISTENER(runtime_combo, runtime_combo_listener);
 ZMK_SUBSCRIPTION(runtime_combo, zmk_position_state_changed);
 ZMK_SUBSCRIPTION(runtime_combo, zmk_keycode_state_changed);
+
+/* DIAG: settings_load() runs before USB logging is up, so boot-time load
+ * failures are invisible on the console. Re-read the persisted behavior
+ * element well after boot, then force a targeted subtree reload and read it
+ * again. If the value only appears after the reload, the boot-time load
+ * dropped it (behavior local IDs are assigned during the same settings_load
+ * pass when CONFIG_ZMK_BEHAVIOR_LOCAL_ID_TYPE_SETTINGS_TABLE is used). */
+static void runtime_combo_diag_work_handler(struct k_work *work) {
+    ARG_UNUSED(work);
+    struct zmk_custom_setting_value value;
+
+    int ret = zmk_custom_setting_read_array_by_key(ZMK_RUNTIME_COMBO_SUBSYSTEM_ID,
+                                                   ZMK_RUNTIME_COMBO_BEHAVIORS_KEY, 0, &value);
+    LOG_ERR("DIAG boot behaviors[0] read_ret=%d id=%u", ret,
+            ret == 0 ? value.behavior_value.behavior_id : 0);
+    LOG_ERR("DIAG boot combos array_size=%u", zmk_runtime_combo_count());
 
+    int load_ret = settings_load_subtree("custom_settings/cormoran__runtime_combo");
+    LOG_ERR("DIAG reload subtree ret=%d", load_ret);
+
+    ret = zmk_custom_setting_read_array_by_key(ZMK_RUNTIME_COMBO_SUBSYSTEM_ID,
+                                               ZMK_RUNTIME_COMBO_BEHAVIORS_KEY, 0, &value);
+    LOG_ERR("DIAG after-reload behaviors[0] read_ret=%d id=%u", ret,
+            ret == 0 ? value.behavior_value.behavior_id : 0);
+
+    struct zmk_runtime_combo_config combo;
+    int combo_ret = zmk_runtime_combo_read(0, &combo);
+    LOG_ERR("DIAG after-reload combo[0] read_ret=%d", combo_ret);
+    zmk_runtime_combo_invalidate_cache();
+}
+
+static K_WORK_DELAYABLE_DEFINE(runtime_combo_diag_work, runtime_combo_diag_work_handler);
+
 static int runtime_combo_init(void) {
     k_work_init_delayable(&timeout_task, combo_timeout_handler);
+    k_work_schedule(&runtime_combo_diag_work, K_SECONDS(12));
     return 0;
 }
 
