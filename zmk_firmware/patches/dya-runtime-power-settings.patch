diff --git a/app/include/zmk/activity.h b/app/include/zmk/activity.h
index 2aad024..8a395f4 100644
--- a/app/include/zmk/activity.h
+++ b/app/include/zmk/activity.h
@@ -6,6 +6,12 @@
 
 #pragma once
 
+#include <stdint.h>
+
 enum zmk_activity_state { ZMK_ACTIVITY_ACTIVE, ZMK_ACTIVITY_IDLE, ZMK_ACTIVITY_SLEEP };
 
 enum zmk_activity_state zmk_activity_get_state(void);
+uint32_t zmk_activity_get_inactive_time_ms(void);
+uint32_t zmk_activity_get_idle_timeout_ms(void);
+uint32_t zmk_activity_get_sleep_timeout_ms(void);
+int zmk_activity_set_timeouts(uint32_t idle_timeout_ms, uint32_t sleep_timeout_ms);
diff --git a/app/src/activity.c b/app/src/activity.c
index f4dc356..d68f4ed 100644
--- a/app/src/activity.c
+++ b/app/src/activity.c
@@ -42,10 +42,10 @@ static enum zmk_activity_state activity_state;
 
 static uint32_t activity_last_uptime;
 
-#define MAX_IDLE_MS CONFIG_ZMK_IDLE_TIMEOUT
+static uint32_t idle_timeout_ms = CONFIG_ZMK_IDLE_TIMEOUT;
 
 #if IS_ENABLED(CONFIG_ZMK_SLEEP)
-#define MAX_SLEEP_MS CONFIG_ZMK_IDLE_SLEEP_TIMEOUT
+static uint32_t sleep_timeout_ms = CONFIG_ZMK_IDLE_SLEEP_TIMEOUT;
 #endif
 
 int raise_event(void) {
@@ -63,6 +63,36 @@ int set_state(enum zmk_activity_state state) {
 
 enum zmk_activity_state zmk_activity_get_state(void) { return activity_state; }
 
+uint32_t zmk_activity_get_inactive_time_ms(void) {
+    return k_uptime_get_32() - activity_last_uptime;
+}
+
+uint32_t zmk_activity_get_idle_timeout_ms(void) { return idle_timeout_ms; }
+
+uint32_t zmk_activity_get_sleep_timeout_ms(void) {
+#if IS_ENABLED(CONFIG_ZMK_SLEEP)
+    return sleep_timeout_ms;
+#else
+    return 0;
+#endif
+}
+
+int zmk_activity_set_timeouts(uint32_t new_idle_timeout_ms, uint32_t new_sleep_timeout_ms) {
+#if !IS_ENABLED(CONFIG_ZMK_SLEEP)
+    if (new_sleep_timeout_ms != 0) {
+        return -ENOTSUP;
+    }
+#endif
+
+    idle_timeout_ms = new_idle_timeout_ms;
+#if IS_ENABLED(CONFIG_ZMK_SLEEP)
+    sleep_timeout_ms = new_sleep_timeout_ms;
+#endif
+    activity_last_uptime = k_uptime_get_32();
+    set_state(ZMK_ACTIVITY_ACTIVE);
+    return 0;
+}
+
 static int note_activity(void) {
     activity_last_uptime = k_uptime_get();
 
@@ -75,7 +105,8 @@ void activity_work_handler(struct k_work *work) {
     int32_t current = k_uptime_get();
     int32_t inactive_time = current - activity_last_uptime;
 #if IS_ENABLED(CONFIG_ZMK_SLEEP)
-    if (inactive_time > MAX_SLEEP_MS && !is_usb_power_present()) {
+    if (sleep_timeout_ms > 0 && inactive_time > sleep_timeout_ms &&
+        !is_usb_power_present()) {
         // Put devices in suspend power mode before sleeping
         set_state(ZMK_ACTIVITY_SLEEP);
 
@@ -88,7 +119,7 @@ void activity_work_handler(struct k_work *work) {
         sys_poweroff();
     } else
 #endif /* IS_ENABLED(CONFIG_ZMK_SLEEP) */
-        if (inactive_time > MAX_IDLE_MS) {
+        if (idle_timeout_ms > 0 && inactive_time > idle_timeout_ms) {
             set_state(ZMK_ACTIVITY_IDLE);
         }
 }
