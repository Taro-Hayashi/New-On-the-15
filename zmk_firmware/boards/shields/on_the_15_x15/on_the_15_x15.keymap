/* Deterministic x15 hardware-test keymap in physical-layout order. */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        bt_fb: bluetooth_feedback {
            compatible = "onthe15,behavior-bt-feedback";
            #binding-cells = <2>;
            display-name = "Bluetooth Feedback";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Test";
            bindings = <
&lt 1 A &kp B &kp C &kp D &kp E &kp F &kp G &kp H &kp I &kp J &kp K &kp L &kp M &kp N &kp O
&kp P   &kp Q &kp R &kp S &kp T &kp U &kp V &kp W &kp X &kp Y &kp Z &kp A &kp B &kp C &kp D
&kp E   &kp F &kp G &kp H &kp I &kp J &kp K &kp L &kp M &kp N &kp O &kp P &kp Q &kp R &kp S
&kp T   &kp U &kp V &kp W &kp X &kp Y &kp Z &kp A &kp B &kp C &kp D &kp E &kp F &kp G &kp H
&kp I   &kp J
            >;
        };

        maintenance_layer: maintenance_layer {
            display-name = "Maintenance";
            bindings = <
&trans       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans &trans &trans &trans &trans &out OUT_TOG
&trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans &trans &trans &trans &trans &trans
&bootloader  &bt BT_CLR
            >;
        };
    };
};
