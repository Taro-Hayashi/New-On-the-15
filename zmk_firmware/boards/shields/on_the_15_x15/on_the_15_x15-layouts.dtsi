/* Physical key order and positions from reference-private/x15.json. */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    on_the_15_x15_transform: on_the_15_x15_transform {
        compatible = "zmk,matrix-transform";
        columns = <32>;
        rows = <3>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,16) RC(0,17) RC(0,18) RC(0,19) RC(0,20) RC(0,21) RC(0,22) RC(0,23)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,16) RC(1,17) RC(1,18) RC(1,19) RC(1,20) RC(1,21) RC(1,22) RC(1,23)
RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,24) RC(0,25) RC(0,26) RC(0,27) RC(0,28) RC(0,29) RC(0,30) RC(0,31)
RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,24) RC(1,25) RC(1,26) RC(1,27) RC(1,28) RC(1,29) RC(1,30) RC(1,31)
RC(2,23) RC(2,0)
        >;
    };

    on_the_15_x15_layout: on_the_15_x15_layout {
        compatible = "zmk,physical-layout";
        display-name = "x15";
        transform = <&on_the_15_x15_transform>;

        keys //                      w   h     x    y     rot     rx   ry
            = <&key_physical_attrs 100 100   125   25       0      0    0>
            , <&key_physical_attrs 100 100   225   25       0      0    0>
            , <&key_physical_attrs 100 100   325   25       0      0    0>
            , <&key_physical_attrs 100 100   425   25       0      0    0>
            , <&key_physical_attrs 100 100   525   25       0      0    0>
            , <&key_physical_attrs 100 100   625   25       0      0    0>
            , <&key_physical_attrs 100 100   725   25       0      0    0>
            , <&key_physical_attrs 100 100   825   25       0      0    0>
            , <&key_physical_attrs 100 100   925   25       0      0    0>
            , <&key_physical_attrs 100 100  1025   25       0      0    0>
            , <&key_physical_attrs 100 100  1125   25       0      0    0>
            , <&key_physical_attrs 100 100  1225   25       0      0    0>
            , <&key_physical_attrs 100 100  1325   25       0      0    0>
            , <&key_physical_attrs 100 100  1425   25       0      0    0>
